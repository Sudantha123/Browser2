<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_normal">

    <!-- Tab strip (chips are added programmatically) -->
    <HorizontalScrollView
        android:id="@+id/tab_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/tabbar">
        <LinearLayout
            android:id="@+id/tab_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </HorizontalScrollView>

    <!-- Address bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/ToolbarButton"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back_button" />

        <ImageButton
            android:id="@+id/btn_forward"
            style="@style/ToolbarButton"
            android:src="@drawable/ic_forward"
            android:contentDescription="@string/forward_button" />

        <ImageButton
            android:id="@+id/btn_home"
            style="@style/ToolbarButton"
            android:src="@drawable/ic_home"
            android:contentDescription="@string/home_button" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <EditText
                android:id="@+id/address_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_address"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textSize="14sp"
                android:hint="@string/address_hint"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/incognito_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="10dp"
                android:text="🕶"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_tabs"
            style="@style/ToolbarButton"
            android:src="@drawable/ic_tabs"
            android:contentDescription="@string/tabs" />

        <ImageButton
            android:id="@+id/btn_menu"
            style="@style/ToolbarButton"
            android:src="@drawable/ic_menu"
            android:contentDescription="@string/menu" />
    </LinearLayout>

    <!-- Page load progress -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressTint="@color/progress"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <!-- Web content -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
